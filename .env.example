# GEMINI_API_KEY: Required for Gemini AI API calls (for images, voice, TTS, speech evaluation).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GIGACHAT_AUTH_DATA: Required for Sber Devices GigaChat text generation API.
# Should be the base64-encoded Client Key / Authorization Data from SberDevices portal.
GIGACHAT_AUTH_DATA=""

# GIGACHAT_SCOPE: Scope of GigaChat API. Use GIGACHAT_API_PERS for personal, GIGACHAT_API_CORP for corporate.
GIGACHAT_SCOPE="GIGACHAT_API_PERS"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

